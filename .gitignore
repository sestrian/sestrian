__pycache__/
*.pyc
.venv/
.DS_Store
client/data/*.txt

# wallets NEVER enter the repo
wallet.json
*.wallet
data/
runs/
corpus/
corpus_mac/
*.bin
dist/

# genesis binaries are RELEASE assets, not repo contents (manifest+sums stay tracked)
dist/genesis.bin
dist/genesis.bin.zst

# Generated at deploy time by scripts/chain_snapshot.py and carried in the
# Pages artifact. Never commit it: a snapshot in git is a stale snapshot.
site/chain.json

# Generated at deploy time by scripts/make_sitemap.py from real commit dates.
# Committing it guarantees the lastmod values drift from the content.
site/sitemap.xml
