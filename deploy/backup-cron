# /etc/cron.d/sestrian-backup — nightly chain-store snapshot on a seed anchor.
# backup-restore.sh produces a consistent tar.zst of the data dir (excludes the
# regenerable genesis.bin); we keep the last 7. Restore drill:
#   deploy/backup-restore.sh restore <file>   (see script header)
25 4 * * * root DATA=/opt/sestrian/data bash /opt/sestrian/deploy/backup-restore.sh backup /opt/sestrian/backups/nightly-$(date +\%Y\%m\%d).tar.zst >/dev/null 2>&1 && ls -t /opt/sestrian/backups/nightly-*.tar.zst | tail -n +8 | xargs -r rm
